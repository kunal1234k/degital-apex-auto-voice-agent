# Required
GOOGLE_API_KEY=your_gemini_api_key
VIDEOSDK_AUTH_TOKEN=your_videosdk_auth_token

# Optional: instead of VIDEOSDK_AUTH_TOKEN you can give these two and the SDK makes the token itself
# VIDEOSDK_API_KEY=
# VIDEOSDK_SECRET_KEY=

# Optional customisation
# AGENT_NAME=Aanya
# GEMINI_VOICE=Leda        # Puck, Charon, Kore, Fenrir, Aoede, Leda, Orus, Zephyr
# GEMINI_MODEL=gemini-3.1-flash-live-preview

# Optional: instant owner alert on Telegram when a lead is saved
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional: also POST every lead as JSON to a webhook (n8n, Make, Supabase edge function, etc.)
# LEAD_WEBHOOK_URL=
